--- /dev/null
+++ b/plex-ffmpeg-source/PlexTranscoder/libavcodec/vvc/vvc_intra_utils.c
@@ -0,0 +1,218 @@
+/*
+ * VVC intra prediction utils
+ *
+ * Copyright (C) 2021 Nuo Mi
+ *
