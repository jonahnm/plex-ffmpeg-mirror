index 00000000..31c931f0
--- /dev/null
+++ b/plex-ffmpeg-source/PlexTranscoder/libavcodec/vvc/vvc_thread.c
@@ -0,0 +1,828 @@
+/*
+ * VVC thread logic
+ *
+ * Copyright (C) 2023 Nuo Mi
+ *
